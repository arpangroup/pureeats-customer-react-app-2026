# Data source switch — this is the ONE thing you change to go from
# standalone (dummy data) to a live backend. See src/config/env.ts.
#
#   mock  -> use the organized dummy data in src/mocks (default, no backend needed)
#   live  -> call the real API at VITE_API_BASE_URL
VITE_DATA_SOURCE=mock

# Base URL of the backend API (the same Spring Boot app the admin panel
# talks to). Only used when VITE_DATA_SOURCE=live.
VITE_API_BASE_URL=http://localhost:8080/api

# Simulated network latency (ms) for mock services, so loading states
# are visible in the UI during development. Set to 0 to disable.
VITE_MOCK_DELAY_MS=350

# A "uat" environment pointed at a real, locally-running backend is
# checked in as .env.uat (VITE_DATA_SOURCE=live, VITE_API_BASE_URL=
# http://localhost:8081/api/v1) — run it with `npm run dev:uat`.

# Google Maps JavaScript API key — used by the address map picker and the
# order-tracking map. Enable "Maps JavaScript API", "Places API" and
# "Geocoding API" on the key's Google Cloud project, with billing on.
# Put your real key in a git-ignored .env.local (copy this file to
# .env.local and fill it in there — never commit a real key). When this is
# empty (or the Google script fails to load), both maps fall back to free
# OpenStreetMap + Leaflet views instead (src/components/maps/OsmMapPicker.tsx,
# OsmOrderTrackingMap.tsx) — no key needed there.
VITE_GOOGLE_MAPS_API_KEY=

# UPI payee identity for the Checkout page's "Pay via UPI" option — opens a
# upi://pay intent on mobile (Android/iOS) that hands off to whichever UPI
# app the customer has installed (GPay, PhonePe, Paytm, BHIM, ...), prefilled
# with this VPA, the order total, and an order reference. Set VITE_UPI_PAYEE_VPA
# to your own UPI ID to actually receive test payments — there's no gateway
# behind this to confirm completion (see CheckoutPage.tsx), the same trust
# model the existing Cash on Delivery option already uses.
# VITE_UPI_PAYEE_VPA=pureeats@upi
# VITE_UPI_PAYEE_NAME=PureEats
VITE_UPI_PAYEE_VPA=arpangroup1@okhdfcbank
VITE_UPI_PAYEE_NAME=arpan jana
